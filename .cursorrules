defineCustomElements(window);

ReactDOM.createRoot(document.getElementById('root')!).render(
  <React.StrictMode>
    <App/>
  </React.StrictMode>
);

### E. Connecteur API Trimble Connect Workspace (src/services/trimbleApi.ts)
import { createWorkspaceApi, WorkspaceApi } from "@trimble-oss/connect-workspace-api";
import { ColorRGBA } from "../types/schedule";

export async function initTrimbleApi(): Promise<WorkspaceApi | null> {
  try {
    const api = await createWorkspaceApi();
    console.log("Connecté avec succès à Trimble Connect Workspace API");
    return api;
  } catch (error) {
    console.warn("API Workspace non disponible (Exécution locale / Mode Demo Mock)");
    return null;
  }
}

export async function setObjectsColor(
  workspaceApi: WorkspaceApi | null, 
  ids: string[], 
  color: ColorRGBA
) {
  if (!workspaceApi || ids.length === 0) return;
  try {
    await workspaceApi.viewer.setObjectColor({ ids, color });
  } catch (err) {
    console.error("Erreur lors de la mise à jour des couleurs :", err);
  }
}

export async function resetObjectsColor(workspaceApi: WorkspaceApi | null) {
  if (!workspaceApi) return;
  try {
    await workspaceApi.viewer.resetObjectColors();
  } catch (err) {
    console.error("Erreur lors de la réinitialisation des couleurs :", err);
  }
}

export async function hideObjects(workspaceApi: WorkspaceApi | null, ids: string[]) {
  if (!workspaceApi || ids.length === 0) return;
  try {
    await workspaceApi.viewer.setObjectVisibility({ ids, visible: false });
  } catch (err) {
    console.error("Erreur lors du masquage des objets :", err);
  }
}

export async function showAllObjects(workspaceApi: WorkspaceApi | null) {
  if (!workspaceApi) return;
  try {
    await workspaceApi.viewer.resetObjectVisibility();
  } catch (err) {
    console.error("Erreur lors du réaffichage des objets :", err);
  }
}

export function subscribeToSelection(
  workspaceApi: WorkspaceApi | null, 
  callback: (selectedObjects: any[]) => void
) {
  if (!workspaceApi) return;
  workspaceApi.viewer.onSelectionChanged(async (selection) => {
    callback(selection);
  });
}

