{
  "rewrites": [
    { "source": "/manifest", "destination": "/manifest.json" },
    { "source": "/manifes", "destination": "/manifest.json" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "*" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors https://*.connect.trimble.com https://web.connect.trimble.com https://app.connect.trimble.com https://*.trimble.com" }
      ]
    }
  ]
}
